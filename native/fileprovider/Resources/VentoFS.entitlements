<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox disabled for local development; enable for distribution -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Shared app group for host app ↔ extension communication -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.io.ventoos.VentoFS</string>
    </array>

    <!-- Allow outgoing network connections to VentoOS server -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
